{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "citation-workflow-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {"ALLOWED_ORIGINS": "https://marronyao.github.io,http://localhost:8080,http://127.0.0.1:8080,http://127.0.0.1:8081"},
  "ratelimits": [{"name":"RATE_LIMITER","namespace_id":"4032001","simple":{"limit":120,"period":60}}],
  "observability": {"enabled": true}
}
